[Tests]
  design = 'PorousFlowInjectionWell.md PorousFlowProductionWell.md'
  issues = '#30392'

  [injection_2comp_hand]
    type = 'CSVDiff'
    input = 'injection_2comp_hand.i'
    csvdiff = 'injection_2comp.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall simulate a multi-component injection well built from point sources by hand.'
  []
  [injection_2comp_action]
    type = 'CSVDiff'
    input = 'injection_2comp_action.i'
    prereq = injection_2comp_hand
    csvdiff = 'injection_2comp.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall reproduce a hand-built multi-component injection well exactly using the Wells block, splitting the total rate between the fluid components according to the injected composition.'
  []

  [production_2comp_hand]
    type = 'CSVDiff'
    input = 'production_2comp_hand.i'
    csvdiff = 'production_2comp.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall simulate a multi-component production well built from polyline sinks by hand.'
  []
  [production_2comp_action]
    type = 'CSVDiff'
    input = 'production_2comp_action.i'
    prereq = production_2comp_hand
    csvdiff = 'production_2comp.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall reproduce a hand-built multi-component production well exactly using the Wells block, producing the resident composition of the reservoir.'
  []

  [injection_thermal_hand]
    type = 'CSVDiff'
    input = 'injection_thermal_hand.i'
    csvdiff = 'injection_thermal.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall simulate a nonisothermal injection well, with its mass and enthalpy point sources built by hand.'
  []
  [injection_thermal_action]
    type = 'CSVDiff'
    input = 'injection_thermal_action.i'
    prereq = injection_thermal_hand
    csvdiff = 'injection_thermal.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall reproduce a hand-built nonisothermal injection well exactly using the Wells block, adding an enthalpy source that carries the total mass rate at the injection temperature.'
  []

  [injection_scheduled]
    type = 'CSVDiff'
    input = 'injection_scheduled.i'
    csvdiff = 'injection_scheduled.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall shut a scheduled injection well in exactly on its start and end times, and shall report zero rate while the well is shut.'
  []

  [production_scheduled]
    type = 'CSVDiff'
    input = 'production_scheduled.i'
    csvdiff = 'production_scheduled.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall shut a scheduled production well in by gating the flux of its polyline sinks, so that its produced mass, rate and cumulative all read zero while it is shut rather than holding their last open-step values.'
  []

  [production_scheduled_parallel]
    type = 'CSVDiff'
    input = 'production_scheduled.i'
    prereq = production_scheduled
    csvdiff = 'production_scheduled.csv'
    rel_err = 1.0E-5
    min_parallel = 2
    max_parallel = 2
    requirement = 'The system shall gate a scheduled production well identically in parallel, the gate AuxVariable being added early enough for the relationship managers to account for it.'
  []

  [injection_shut_if]
    type = 'CSVDiff'
    input = 'injection_shut_if.i'
    csvdiff = 'injection_shut_if.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall shut a well in when a user-supplied condition on a postprocessor is met, at a time not known in advance.'
  []

  [except_bhp_max_needs_radius]
    type = 'RunException'
    input = 'injection_2comp_action.i'
    cli_args = "Wells/inj1/bhp_max=30e6"
    expect_err = "depends on the radius of the hole"
    requirement = 'The system shall report an error when a well declares a bottom-hole pressure limit but gives its completions as a bare point, since the Peaceman well constant that such a well needs depends on the radius of the hole and a point does not carry one.'
  []
  [injection_bhp_max]
    type = 'CSVDiff'
    input = 'injection_interval.i'
    cli_args = 'Wells/inj1/bhp_max=1e7 Outputs/file_base=injection_bhp_max'
    csvdiff = 'injection_bhp_max.csv'
    abs_zero = 1E-10
    requirement = 'The system shall solve for the bottom-hole pressure of a well declaring a pressure limit, expanding the well into one borehole owning the rate constraint and one per fluid component carrying the injected composition, all sharing a single scalar unknown, and shall hold the limit once the requested rate can no longer be delivered beneath it.'
    design = 'porous_flow/sinks.md PorousFlowPeacemanBorehole.md'
    issues = '#30392'
  []
  [except_wrong_mass_fraction_vars]
    type = 'RunException'
    input = 'injection_2comp_action.i'
    cli_args = "Wells/inj1/mass_fraction_vars=''"
    expect_err = "must have 1 entries"
    requirement = 'The system shall report an error when the number of mass fraction variables supplied to a well is inconsistent with the number of fluid components.'
  []
  [except_wrong_num_injected_fractions]
    type = 'RunException'
    input = 'injection_2comp_action.i'
    cli_args = "Wells/inj1/injected_mass_fractions='0.3 0.3 0.4'"
    expect_err = "must have one entry per fluid component"
    requirement = 'The system shall report an error when the injected composition of a well does not have one entry per fluid component.'
  []
  [except_injected_fractions_sum]
    type = 'RunException'
    input = 'injection_2comp_action.i'
    cli_args = "Wells/inj1/injected_mass_fractions='0.3 0.6'"
    expect_err = "must sum to 1"
    requirement = 'The system shall report an error when the injected composition of a well does not sum to one.'
  []
  [injection_interval]
    type = 'CSVDiff'
    input = 'injection_interval.i'
    csvdiff = 'injection_interval.csv'
    rel_err = 1.0E-5
    requirement = 'The system shall inject at a prescribed rate over a completion interval, generating one completion for each element the interval passes through and dividing the rate between them, so that the mass of each fluid component added to the model matches the cumulative reported by the well.'
    issues = '#30392'
  []
  [except_injector_two_geometries]
    type = 'RunException'
    input = 'injection_2comp_action.i'
    cli_args = "Wells/inj1/point_file=prod1.bh"
    expect_err = "completions are given both by"
    requirement = 'The system shall report an error when a well is given its completions both as a single point and as a completion interval.'
  []
  [except_thermal_missing_fp]
    type = 'RunException'
    input = 'injection_thermal_except.i'
    expect_err = "also needs 'fp' and 'injection_temperature'"
    requirement = 'The system shall report an error when a nonisothermal well omits the fluid properties or injection temperature needed to compute the injected enthalpy.'
  []
  [except_reopen_if]
    type = 'RunException'
    input = 'production_2comp_action.i'
    cli_args = "Wells/prod1/reopen_if='something'"
    expect_err = "'reopen_if' is not yet implemented"
    requirement = 'The system shall report an error, rather than silently ignoring the parameter, when a well requests a reopen condition.'
  []
  [except_end_before_start]
    type = 'RunException'
    input = 'injection_scheduled.i'
    cli_args = "Wells/inj1/end_time=100"
    expect_err = "'end_time' must be greater than 'start_time'"
    requirement = 'The system shall report an error when a well is scheduled to shut before it opens.'
  []
  [injection_constrained_rate]
    type = 'CSVDiff'
    input = 'injection_interval.i'
    cli_args = 'Wells/inj1/bhp_max=1e12 Outputs/file_base=injection_constrained_rate'
    csvdiff = 'injection_constrained_rate.csv'
    abs_zero = 1E-10
    requirement = 'The system shall deliver the rate requested of a well whose bottom-hole pressure is solved for, dividing it between the completions and between the fluid components according to the injected composition, when the pressure limit never binds.'
    design = 'porous_flow/sinks.md PorousFlowPeacemanBorehole.md'
    issues = '#30392'
  []
  [injection_constrained_rate_parallel]
    type = 'CSVDiff'
    input = 'injection_interval.i'
    cli_args = 'Wells/inj1/bhp_max=1e12 Outputs/file_base=injection_constrained_rate'
    csvdiff = 'injection_constrained_rate.csv'
    abs_zero = 1E-10
    prereq = injection_constrained_rate
    min_parallel = 2
    max_parallel = 2
    requirement = 'The system shall divide a well\'s requested rate between completions lying on different processors so that the total delivered is the rate asked for, giving the same answer on two processors as on one.'
    design = 'porous_flow/sinks.md PorousFlowPeacemanBorehole.md'
    issues = '#30392'
  []
  [injection_constrained_rate_parallel4]
    type = 'CSVDiff'
    input = 'injection_interval.i'
    cli_args = 'Wells/inj1/bhp_max=1e12 Outputs/file_base=injection_constrained_rate'
    csvdiff = 'injection_constrained_rate.csv'
    abs_zero = 1E-10
    prereq = injection_constrained_rate_parallel
    min_parallel = 4
    max_parallel = 4
    requirement = 'The system shall divide a well\'s requested rate between completions independently of how many processors the completions are spread across, giving the same answer on four processors as on one.'
    design = 'porous_flow/sinks.md PorousFlowPeacemanBorehole.md'
    issues = '#30392'
  []
  [injection_wellbore_gradient]
    type = 'CSVDiff'
    input = 'injection_interval.i'
    cli_args = "Wells/inj1/bhp_max=1e12 Wells/inj1/wellbore_density=1000 GlobalParams/gravity='0 -9.81 0' Outputs/file_base=injection_wellbore_gradient"
    csvdiff = 'injection_wellbore_gradient.csv'
    abs_zero = 1E-10
    requirement = 'The system shall carry the weight of the fluid standing in the wellbore down to each completion, so that a well completed over a tall interval does not see its bottom-hole pressure throughout, while still delivering the rate asked of it.'
    design = 'porous_flow/sinks.md PorousFlowPeacemanBorehole.md'
    issues = '#30392'
  []
  [injection_fv]
    type = 'CSVDiff'
    input = 'injection_fv.i'
    cli_args = 'Outputs/file_base=injection_fv'
    csvdiff = 'injection_fv.csv'
    abs_zero = 1E-8
    requirement = 'The system shall build a finite-volume Peaceman borehole for an injection well with a pressure limit when the fluid variables are finite-volume variables, delivering the requested rate while the limit is not reached.'
    design = 'PorousFlowInjectionWell.md PorousFlowPeacemanBorehole.md'
    issues = '#34110'
  []
  [injection_fv_bhp_max]
    type = 'CSVDiff'
    input = 'injection_fv.i'
    cli_args = 'Wells/inj/bhp_max=1.025E7 Outputs/file_base=injection_fv_bhp_max'
    csvdiff = 'injection_fv_bhp_max.csv'
    abs_zero = 1E-8
    requirement = 'The system shall hold the bottom-hole pressure of a finite-volume injection well at its limit, and inject whatever rate that pressure sustains, once the requested rate would need a higher pressure.'
    design = 'PorousFlowInjectionWell.md PorousFlowPeacemanBorehole.md'
    issues = '#34110'
  []
  [production_fv_error]
    type = RunException
    input = 'production_fv_error.i'
    expect_err = 'is only available for finite-element variables'
    requirement = 'The system shall report an error if a production well is used with finite-volume variables.'
    design = 'PorousFlowProductionWell.md'
    issues = '#34110'
  []
[]
